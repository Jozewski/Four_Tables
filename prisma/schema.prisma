generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Recipe {
  id          Int          @id @default(autoincrement())
  title       String
  description String?
  cultural    String       // "Italian" | "Dutch" | "German" | "Mexican"
  holiday     String?      // "Christmas" | "Easter" | "Thanksgiving" | null for everyday
  category    String       // "Main" | "Dessert" | "Bread" | "Soup" | "Side" | "Seafood" | "Appetizer"
  prepTime    Int?         // minutes
  imageUrl    String?      // URL to food photography
  createdAt   DateTime     @default(now())
  archivedAt  DateTime?

  notes       FamilyNote[]
  ingredients Ingredient[]
  steps       Step[]
}

model FamilyNote {
  id        Int      @id @default(autoincrement())
  author    String
  content   String
  createdAt DateTime @default(now())

  recipe    Recipe   @relation(fields: [recipeId], references: [id])
  recipeId  Int
}

model Ingredient {
  id       Int     @id @default(autoincrement())
  order    Int
  amount   String
  unit     String?
  name     String

  recipe   Recipe  @relation(fields: [recipeId], references: [id])
  recipeId Int
}

model Step {
  id          Int    @id @default(autoincrement())
  stepNumber  Int
  instruction String

  recipe      Recipe @relation(fields: [recipeId], references: [id])
  recipeId    Int
}
